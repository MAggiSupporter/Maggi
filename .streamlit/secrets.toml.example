# 1. Copy this file to .streamlit/secrets.toml (same folder, without ".example").
# 2. Replace the text inside the quotes with your OpenRouter key from
#    https://openrouter.ai/settings/keys
# 3. Save, then restart the app.
# secrets.toml is listed in .gitignore, so git will not commit it.

OPENROUTER_API_KEY = "sk-or-v1-your-key-here"
